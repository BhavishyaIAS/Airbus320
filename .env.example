# Copy this file to `.env.local` and fill in values from your Supabase project.
# Never commit `.env.local` — it is gitignored.
#
# Where to find these (Supabase dashboard → your project):
#   Settings → API → Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#   Settings → API → Project API keys → anon/public  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Settings → API → Project API keys → service_role -> SUPABASE_SERVICE_ROLE_KEY

# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never expose to the browser or commit. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
